#!/bin/sh
set -e
# Stop the console before its binary goes. An upgrade restarts it in
# postinst instead.
if [ "$1" = "remove" ]; then
    if [ -d /run/systemd/system ]; then
        systemctl stop lotse-console.service >/dev/null 2>&1 || true
    elif [ -x /etc/init.d/lotse-console ]; then
        if command -v invoke-rc.d >/dev/null; then
            invoke-rc.d lotse-console stop || true
        else
            /etc/init.d/lotse-console stop || true
        fi
    fi
fi
