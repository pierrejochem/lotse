# The tools a release is built with (ADR 0126). A release is reproducible:
# the same commit built with these versions gives the same bytes, on any
# machine. `packaging/tools.sh` installs them; `packaging/release.sh` refuses
# other versions unless LOTSE_RELEASE_UNPINNED=1 (the build then works, but
# its bytes differ from the published ones).
#
# Change a version here only, in its own commit: every file of the next
# release changes with it.
RUST_VERSION=1.97.0
ZIG_VERSION=0.15.2
CARGO_ZIGBUILD_VERSION=0.24.0
NFPM_VERSION=2.49.0
# The console's web app (ADR 0137): npm ci installs what
# console/web/package-lock.json pins, with this Node.js and its npm.
NODE_VERSION=22.23.4
NFPM_SHA256_X86_64=2afaa5ffb5e3493402e31e7c67a5a1fb42133e3f66fc315ca0051934125561c7
NFPM_SHA256_ARM64=d4eee71839e92c68cbd3b101640bad32d2856fc551acae0635be9118e48c9d9c
