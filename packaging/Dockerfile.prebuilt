# The release image (ADR 0049): the same as packaging/Dockerfile, from
# static binaries the release workflow built already, one per platform, in
# dist/lotse-<arch> (amd64, arm64).
FROM gcr.io/distroless/static-debian12:nonroot
ARG TARGETARCH
COPY --chmod=0755 dist/lotse-${TARGETARCH} /usr/bin/lotse
ENV LOTSE_CONFIG=/etc/lotse/cluster.toml
VOLUME ["/var/lib/lotse"]
EXPOSE 7000 9000
USER 65532:65532
ENTRYPOINT ["/usr/bin/lotse"]
CMD ["run"]
