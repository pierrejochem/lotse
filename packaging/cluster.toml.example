# A Lotse cluster file (ADR 0047): the same on every node. Copy it to
# /etc/lotse/cluster.toml, name your nodes, make the certificates with
#
#   lotse certs --config /etc/lotse/cluster.toml
#
# and start each node: `systemctl enable --now lotse@<id>` under systemd,
# `rc-service lotse.<id> start` under OpenRC, or LOTSE_NODE in
# /etc/default/lotse and `/etc/init.d/lotse start` under sysvinit.

[cluster]
data_dir = "/var/lib/lotse"
# election_timeout_ms = 1000   # a group elects after this long without a leader, up to twice as long (ADR 0144)
# heartbeat_ms = 100
# segment_ms = 3600000       # a stream's or queue's segment closes at this age, so retention can free it (ADR 0146)

[quotas]
# check_interval_ms = 10000   # how often storage quotas are counted; a tenant may overshoot by what it writes in about two of these (ADR 0147)

[[node]]
id = 1
peer = "10.0.0.1:7000"
client = "10.0.0.1:9000"
metrics = "10.0.0.1:9464"   # /metrics, /healthz, /readyz, /safe-to-stop (ADR 0117); leave out to serve none

[[node]]
id = 2
peer = "10.0.0.2:7000"
client = "10.0.0.2:9000"
metrics = "10.0.0.2:9464"

[[node]]
id = 3
peer = "10.0.0.3:7000"
client = "10.0.0.3:9000"
metrics = "10.0.0.3:9464"

[tls]
ca = "/etc/lotse/ca.pem"
cert = "/etc/lotse/node-{id}.pem"
key = "/etc/lotse/node-{id}.key"
crl = "/etc/lotse/crl.pem"   # `lotse certs --revoke <cert>` adds to it; same file on every node

[retention]
ms = 604800000      # 7 days; -1 keeps everything

[auth]
admins = ["admin"]  # signs in with `lotse certs --client admin`
