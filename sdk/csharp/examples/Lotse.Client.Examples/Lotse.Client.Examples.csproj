<Project Sdk="Microsoft.NET.Sdk">

  <!-- Programs to run against a cluster. They are part of the solution, so the build keeps them in step with the API. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Lotse.Examples</RootNamespace>
    <AssemblyName>Lotse.Client.Examples</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lotse.Client\Lotse.Client.csproj" />
  </ItemGroup>

</Project>
