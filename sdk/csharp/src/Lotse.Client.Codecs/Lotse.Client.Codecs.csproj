<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Lotse.Codecs</RootNamespace>
    <AssemblyName>Lotse.Client.Codecs</AssemblyName>
    <PackageId>Lotse.Client.Codecs</PackageId>
    <Version>0.2.0</Version>
    <Description>The zstd and LZ4 codecs for Lotse.Client (optional; ADR 0084).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Both are written in managed code, so there is no native library to ship per platform. Pinned. -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lotse.Client\Lotse.Client.csproj" />
  </ItemGroup>

  <!-- The codecs are built against one release of Lotse.Client, so the package names that release exactly
       ([x.y.z]) instead of NuGet's default "at least" (ADR 0142). -->
  <Target Name="PinProjectReferenceVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(_ProjectReferencesWithVersions.ProjectVersion)]" />
    </ItemGroup>
  </Target>

</Project>
