{
  "name": "@pierrejochem/lotse-client",
  "version": "0.2.0",
  "description": "Node.js client for Lotse, a message broker with reliable queues and persistent streams.",
  "license": "Apache-2.0",
  "author": "Pierre Jochem",
  "homepage": "https://github.com/pierrejochem/lotse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pierrejochem/lotse.git",
    "directory": "sdk/node"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "example:stream": "tsc -p tsconfig.json && node dist/examples/stream.js",
    "example:queue": "tsc -p tsconfig.json && node dist/examples/queue.js",
    "example:exactly-once": "tsc -p tsconfig.json && node dist/examples/exactly-once.js",
    "example:idiomatic": "tsc -p tsconfig.json && node dist/examples/idiomatic.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
